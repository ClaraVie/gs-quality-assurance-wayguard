  <folder name="Technology &amp; Physical" id="id-22d4920f7d71422bb100bf2e8c76af30" type="technology"/>
  <folder name="Motivation" id="id-cae335da039d44da9e20d1a0fe9ddb5f" type="motivation">
    <element xsi:type="archimate:Driver" name="Driver" id="id-f4d56abc12f54e90a2645c880f747658"/>
    <element xsi:type="archimate:Stakeholder" name="Cidadão / Usuário Final de Mobilidade Urbana" id="id-819045cf53d54ebeb3c9e490a4fdb9af"/>
    <element xsi:type="archimate:Driver" name="Superar a deficiência de terreno nos mapas convencionais: Aprimorar o uso de dados geoespaciais e altimetria detalhada para preencher lacunas deixadas pelo GPS tradicionais, que foram focados em veículos e tempo, ignorando a inclinação real das calçadas e escadarias." id="id-348644b2925248b5b3745b35cda177e8"/>
    <element xsi:type="archimate:Driver" name="Eliminar surpresas e barreiras físicas inesperadas nas rotas a pé. Conquistar total previsibilidade e segurança no deslocamento urbano, permitindo que o usuário saiba exatamente quais obstáculos enfrentará antes de dar o primeiro passo." id="id-7e442c66c144417c860a8c3927ca33aa"/>
    <element xsi:type="archimate:Driver" name="Garantir acessibilidade urbana inclusiva para pedestres. Alcançar a inclusão real de pessoas com deficiência (PCD) e mobilidade reduzida, eliminando a invisibilidade destas pessoas nos planejamentos urbanos tradicionais." id="id-15b25d1eaf794d79beba7e75fd36eefa"/>
    <element xsi:type="archimate:Assessment" name="Integrar bases geoespaciais abertas de relevo e calçadas." id="id-936d83fd79914c2cb0ca3c489e8b365f"/>
    <element xsi:type="archimate:Assessment" name="Desenvolver motor de mapeamento de terreno e rotas acessíveis." id="id-f265e05d9bb247399b0613c070da2932"/>
    <element xsi:type="archimate:Assessment" name="Criar sistema de alertas visuais em tempo real via widget flutuante." id="id-6487242f04d94b43ba162caabfeb09ed"/>
    <element xsi:type="archimate:Driver" name="Oferecer sistema de filtros personalizados por perfil físico. Resultado direto onde o usuário adapta a leitura do mapa conforme sua condição física." id="id-d6b92953be854a4f84544bab67fdc184"/>
    <element xsi:type="archimate:Driver" name="Gerenciar e classificar a severidade da rota em tempo real. Resultado operacional que transforma dados brutos de relevo em status compreensíveis (Acessível, Atenção ou Crítico)." id="id-45966f68cb6840c7acb2aafb4997e3f4"/>
    <element xsi:type="archimate:Driver" name="Enriquecer os mapas digitais com camadas de dados de relevo e barreiras de calçada." id="id-948839d68d8d405c9ee9e9d1bdfaec78"/>
    <element xsi:type="archimate:Outcome" name="Meta de mapear e classificar 100% dos declives escadarias ao longo do trajeto traçado pelo usuário." id="id-f4812675a6684f17be98aba11b25c681"/>
    <element xsi:type="archimate:Outcome" name="Meta de garantir que 100% das rotas calculadas apliquem instantaneamente os filtros do perfil físico selecionado." id="id-5c96ac95bc4f4083a9d1f7c40f2162ed"/>
    <element xsi:type="archimate:Outcome" name="Meta de garantir 100% de alerta para escadarias sem rampa no perfil PCD/Acessibilidade: Nenhuma rota sugerida no perfil de acessibilidade pode conter degraus intrasponíveis sem aviso crítico imediato." id="id-0e84ce7b2a634dcc91a5929308aa29e0"/>
    <element xsi:type="archimate:Outcome" name="Meta de exibir o micro-cartão de aleta em menos de 1 segundo após traçar a rota(Instantanidade): Garantir tempo de resposta instantâneo na interface UX/UI para não atrasar o deslocamento do cidadão" id="id-5015fdbde0cb4e80a7b83664472e6471"/>
    <element xsi:type="archimate:Requirement" name="Classificar trechos da rota por nível de dificuldade." id="id-4cd7ca3ca2004e73b92cb6044abe0e5d"/>
    <element xsi:type="archimate:Constraint" id="id-ef49af5b155d46798c029ca1b5a187fe"/>
    <element xsi:type="archimate:Requirement" name="Exibir micro-cartão de alerta visual na tela" id="id-fce472b8833e4fdb9f97bf137fccba6f"/>
    <element xsi:type="archimate:Constraint" name="O aviso deve aparecer na tela em menos de 1 segundo após traçar a rota, sem atrapalhar a visão do mapa." id="id-0706c2e74705447396d9e7ecafdf351b"/>
    <element xsi:type="archimate:Constraint" name="O sistema deve classificar cada trecho como Acessível, Atenção ou Crítico usando dados oficiais de relevo. Se o perfil PCD estiver ativo, escadarias sem rampa nunca podem ser sugeridas sem aviso crítico." id="id-7d2c33f30af143f0b4d6789c54d093ff"/>
    <element xsi:type="archimate:Requirement" name="Filtrar e recalcular rotas conforme o perfil físico." id="id-0dbb7b9a1672472ba4324bec79f8ce3e"/>
    <element xsi:type="archimate:Constraint" name="Ao selecionar um perfil físico (ex: cadeirante ou mobilidade reduzida), 100% das rotas calculadas devem aplicar os filtros instantaneamente na mesma hora." id="id-554d1a318489424b927d002aad13dbd5"/>
  </folder>
